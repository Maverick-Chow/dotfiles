#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  topmost=window \
  height=34 \
  notch_display_height=34 \
  y_offset=8 \
  margin=10 \
  padding_left=0 \
  corner_radius=12 \
  blur_radius=30 \
  color=0x33000000 \
  border_width=1 \
  border_color=0x22ffffff


##### Changing Defaults #####
default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font:Regular:14.0"
  label.font="SF Pro:Semibold:14.0"
  icon.color=$WHITE
  label.color=$WHITE
  icon.padding_left=5
  icon.padding_right=5
  label.padding_left=5
  label.padding_right=5
  background.padding_left=5
  background.padding_right=5
)
sketchybar --default "${default[@]}"

##### Events #####
sketchybar --add event aerospace_workspace_change

##### Left spacer (keeps center truly centered) #####
# sketchybar --add item spacer_left left \
#   --set spacer_left width=dynamic icon.drawing=off label.drawing=off background.drawing=off

##### AeroSpace workspaces (CENTER) #####
for sid in $(aerospace list-workspaces --all); do
  case "$sid" in
    *)  space_icon="$sid" ;;
  esac

  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
      background.color=$TRANSPARENT \
      background.height=25 \
      background.corner_radius=10 \
      background.drawing=off \
      icon.padding_left=10 \
      icon.padding_right=10 \
      icon.y_offset=-1 \
      label.padding_left=5 \
      label.padding_right=10 \
      label.y_offset=0 \
      background.padding_left=6 \
      background.padding_right=6 \
      y_offset=0 \
      icon="$space_icon" \
      icon.font="SF Pro:Bold:16.0" \
      icon.highlight_color=$ACCENT \
      label.drawing=off \
      label.font="sketchybar-app-font:Regular:14.0" \
      click_script="aerospace workspace $sid" \
      script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

